[Unit]
Description=Hermes VM daily liveness check (agent import, WebUI health, unit count)
Documentation=https://github.com/mnbf9rca/kubernetes_config/blob/master/docs/operations/hermes-vm.md
# NO network-online.target ORDERING IS POSSIBLE HERE, and its absence is
# deliberate rather than an omission. This runs under the USER manager, and
# Debian ships no network-online.target for the user manager - confirmed by
# listing the directory. `Wants=` on a unit that cannot be loaded is tolerated
# in silence and `After=` on one imposes no ordering at all, so the two lines
# that used to sit here were dead, while reading to the next person as an
# ordering guarantee that never existed. They were removed on 2026-08-27.
# DO NOT RE-ADD THEM.
#
# The cost is specific and lands on the Persistent=true catch-up path: a run
# that fires as the VM comes back can beat the network up, the push then fails,
# push_kuma swallows that failure and still returns 0, and so the monitor sees
# SILENCE rather than a `down`. It therefore stays GREEN until the 24-hour
# heartbeat interval and its 6-hour retry expire, instead of going red at once.

[Service]
Type=oneshot
ExecStart=/home/hermes/bin/hermes-app-alive.sh

# THE WORKING DIRECTORY MUST BE WHAT IT IS BY CONSTRUCTION, not by the
# coincidence that an unset WorkingDirectory= in a systemd USER unit defaults to
# the user's home. hermes-app-alive.sh pins no working directory of its own, so
# this line is the only pin there is.
#
# The failure it forecloses is specific. This script's central assertion is
# `python -c 'import run_agent'` against the shared venv, and `python -c` puts
# the CURRENT WORKING DIRECTORY on sys.path. Started from inside the agent
# checkout, that import can resolve run_agent from the checkout's own source
# rather than from the venv, so the assertion passes on a venv in which the
# agent package is not installed at all. That false pass is exactly the failure
# this check exists to catch, so it must not be reachable from the check's own
# working directory.
#
# Under the timer the default working directory is already /home/hermes, so the
# scheduled run was never at risk. What this covers is a HAND-DEBUG run started
# from somewhere else - which is exactly when an operator is asking the check
# whether the venv is broken.
WorkingDirectory=/home/hermes

# HERMES_HOME is pinned rather than inherited: everything hermes resolves under
# $HERMES_HOME is resolved by absolute path from that variable. This script only
# reads paths it hard-codes, so the line is defensive rather than load-bearing -
# but a unit whose HERMES_HOME disagreed with the installed layout would be a
# trap for the next person.
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The push URL, which carries the monitor's token as its last path segment.
# Mode 0600, written at install by `op read` piped over ssh. No leading '-':
# the unit must refuse to start when the file is absent, because a check that
# cannot push is indistinguishable from a check that never ran.
EnvironmentFile=/home/hermes/.hermes/hermes-app-alive.env

# Three local assertions and one HTTPS push. Two minutes is generous; the point
# of the bound is that a wedged run FAILS rather than sitting in `activating`.
# On expiry systemd sends SIGTERM, which the script traps and converts to exit
# 143 so the EXIT trap still pushes `down` - without that trap a timeout would
# be silence, and silence here reads as a healthy day until the heartbeat
# lapses.
TimeoutStartSec=120

# No Restart=. A `down` push is the report; retrying would just overwrite it.
StandardOutput=journal
StandardError=journal

# No [Install] section: the TIMER is what gets enabled, not the service.
